// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  password  String @db.Text
  role  String?
}
model Job {
  id                Int      @id @default(autoincrement())
  job_code          String   @unique
  title             String
  city              Json 
  publication_date  DateTime
  deadline          DateTime
  age               Int?
  qualification     String   @db.Text
  skill             String?  @db.Text
  responsibility    String?  @db.Text
  special_info      String?  @db.Text
  doc1_title        String?
  doc1_attachment   String?
  doc2_title        String?
  doc2_attachment   String?
  req1_doc_title    String?
  req2_doc_title    String?
  job_type          String
  email             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}